def cmd_config(app, args):
    cfg = app.cfg
    if args.action == "path":
        emit(args, {"config": cfg.path, "token_file": token_file_path()}, "config: %s\ntoken file: %s" % (cfg.path, token_file_path()))
        return
    if args.action == "show":
        data = {"path": cfg.path, "present": cfg.present, "team_id": cfg.team_id,
                "allow": {"spaces": sorted(cfg.spaces), "folders": sorted(cfg.folders), "lists": sorted(cfg.lists)},
                "status_overrides": cfg.status_overrides}
        emit(args, data, json.dumps(data, indent=2))
        return
    # discover: Space/Folder/List names and ids, for a person filling in the allow-list.
    team = app.team_id()
    spaces = app.api.get("/team/%s/space" % team, {"archived": False}).get("spaces") or []
    if args.space:
        spaces = [s for s in spaces if str(s.get("id")) == args.space]
    out, lines = [], []
    for s in spaces:
        entry = {"id": str(s.get("id")), "name": one_line(s.get("name"), 120), "allowed": str(s.get("id")) in cfg.spaces}
        lines.append("space  %s  %s%s" % (entry["id"], entry["name"], "  [allowed]" if entry["allowed"] else ""))
        if args.space:
            entry["folders"], entry["lists"] = [], []
            for f in app.api.get("/space/%s/folder" % s["id"], {"archived": False}).get("folders") or []:
                fe = {"id": str(f.get("id")), "name": one_line(f.get("name"), 120),
                      "lists": [{"id": str(l.get("id")), "name": one_line(l.get("name"), 120)} for l in f.get("lists") or []]}
                entry["folders"].append(fe)
                lines.append("  folder %s  %s" % (fe["id"], fe["name"]))
                lines.extend("    list %s  %s" % (l["id"], l["name"]) for l in fe["lists"])
            for l in app.api.get("/space/%s/list" % s["id"], {"archived": False}).get("lists") or []:
                le = {"id": str(l.get("id")), "name": one_line(l.get("name"), 120)}
                entry["lists"].append(le)
                lines.append("  list   %s  %s" % (le["id"], le["name"]))
        out.append(entry)
    if not args.space:
        lines.append("(add --space ID to see its Folders and Lists)")
    emit(args, {"workspace": team, "spaces": out}, "\n".join(lines))


