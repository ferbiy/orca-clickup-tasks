def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="machine-readable JSON output")
    writes = argparse.ArgumentParser(add_help=False)
    writes.add_argument("--dry-run", action="store_true", help="check and show the request, change nothing")

    p = argparse.ArgumentParser(
        prog="clickup", description="Read and update ClickUp tasks inside the configured allow-list.",
        epilog="Token: $CLICKUP_TOKEN_FILE or ~/.clickup-token. Config: $CLICKUP_CONFIG or "
               "~/.config/clickup-agent/config.json. Exit codes: 0 ok, 1 ClickUp error, 2 usage, 3 config/token, "
               "4 token rejected, 5 outside allow-list, 6 not found, 7 rate limited, 8 network/ClickUp down.")
    p.add_argument("--json", action="store_true", default=False, help="machine-readable JSON output")
    p.add_argument("--version", action="version", version="clickup " + VERSION)
    sub = p.add_subparsers(dest="command", metavar="command")

    def add(name, func, help_, parents=(common,)):
        sp = sub.add_parser(name, help=help_, description=help_, parents=list(parents))
        sp.set_defaults(func=func)
        return sp

    add("me", cmd_me, "who the token belongs to, Workspaces, allow-list summary")

    sp = add("lists", cmd_lists, "Lists inside the allow-list")
    sp.add_argument("--statuses", action="store_true", help="also show each List's statuses and alias mapping")

    sp = add("statuses", cmd_statuses, "a List's statuses and what in-progress/review/done resolve to")
    sp.add_argument("task", nargs="?", help="task id (uses its List)")
    sp.add_argument("--list", help="List id")

    sp = add("tasks", cmd_tasks, "tasks in allowed Lists (one page, 100 max)")
    sp.add_argument("--list", help="only this List (must be allowed)")
    sp.add_argument("--mine", action="store_true", help="assigned to me")
    sp.add_argument("--assignee", action="append", help="user id or 'me' (repeatable)")
    sp.add_argument("--status", action="append", help="exact status name (repeatable)")
    sp.add_argument("--status-type", action="append", choices=["open", "custom", "done", "closed"],
                    help="keep only this status type (repeatable)")
    sp.add_argument("--updated-since", help="2h, 3d, 1w, an ISO date, or epoch ms")
    sp.add_argument("--include-closed", action="store_true", help="include closed tasks")
    sp.add_argument("--subtasks", action="store_true", help="include subtasks")
    sp.add_argument("--page", type=int, default=0)
    sp.add_argument("--limit", type=int, default=50, help="rows to show (default 50)")

    sp = add("task", cmd_task, "one task: description, status, fields, checklists, subtasks, links, recent comments")
    sp.add_argument("task", help="raw id, CU-<id>, custom id (DEV-123), branch name, or task URL")
    sp.add_argument("--comments", type=int, help="how many recent comments (default from config, 5)")

    sp = add("comment", cmd_comment, "add a comment", parents=(common, writes))
    sp.add_argument("task")
    sp.add_argument("text", nargs="*", help="comment text, or - to read stdin")
    sp.add_argument("--file", help="read the comment from a file (- for stdin)")
    sp.add_argument("--notify", action="store_true", help="notify all watchers (default off)")

    sp = add("status", cmd_status, "set status: exact name or in-progress / review / done / closed / open",
             parents=(common, writes))
    sp.add_argument("task")
    sp.add_argument("target")

    sp = add("assign", cmd_assign, "assign (default: me) or --remove", parents=(common, writes))
    sp.add_argument("task")
    sp.add_argument("user", nargs="*", help="'me', numeric user id, or member email (default: me)")
    sp.add_argument("--remove", action="store_true", help="unassign instead")

    sp = add("create", cmd_create, "create a task in an allowed List", parents=(common, writes))
    sp.add_argument("--list", required=True)
    sp.add_argument("--name", required=True)
    sp.add_argument("--description", help="markdown description")
    sp.add_argument("--description-file", help="read the description from a file (- for stdin)")
    sp.add_argument("--status", help="status name or alias")
    sp.add_argument("--assign-me", action="store_true")
    sp.add_argument("--assignee", action="append", help="user id or email (repeatable)")
    sp.add_argument("--parent", help="make it a subtask of this task")
    sp.add_argument("--tag", action="append")
    sp.add_argument("--priority", type=int, choices=[1, 2, 3, 4], help="1 urgent, 2 high, 3 normal, 4 low")

    sp = add("link-branch", cmd_link_branch, "record a git branch on the task (as a comment)", parents=(common, writes))
    sp.add_argument("task")
    sp.add_argument("branch", nargs="?", help="default: current git branch")
    sp.add_argument("--repo", help="repo name or URL")
    sp.add_argument("--notify", action="store_true")

    sp = add("attach-pr", cmd_attach_pr, "record a pull request URL on the task (as a comment)", parents=(common, writes))
    sp.add_argument("task")
    sp.add_argument("url")
    sp.add_argument("--title")
    sp.add_argument("--notify", action="store_true")

    sp = add("branch-name", cmd_branch_name, "suggested branch name CU-<id>-<slug> (ClickUp's GitHub integration links it)")
    sp.add_argument("task")

    sp = add("config", cmd_config, "path | show | discover (Space/Folder/List ids for setting up the allow-list)")
    sp.add_argument("action", choices=["path", "show", "discover"])
    sp.add_argument("--space", help="discover: show this Space's Folders and Lists")
    return p


NO_CONFIG_NEEDED = {"me", "config"}


def main(argv=None, api=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "command", None):
        parser.print_help()
        return EXIT_USAGE
    if not hasattr(args, "dry_run"):
        args.dry_run = False
    try:
        cfg = load_config(required=args.command not in NO_CONFIG_NEEDED)
        if api is None:
            api = ClickUp(max_wait_s=cfg.max_wait_s)
        args.func(App(cfg, api), args)
        return EXIT_OK
    except CliError as exc:
        msg = api.redact(str(exc)) if api is not None else str(exc)
        warn("error: " + msg)
        if getattr(args, "json", False):
            sys.stdout.write(json.dumps({"error": msg, "exit_code": exc.code}) + "\n")
        return exc.code
    except KeyboardInterrupt:
        return 130
    except Exception as exc:  # unexpected response shape etc.; no traceback (it could echo data)
        if os.environ.get("CLICKUP_DEBUG") == "1":
            raise
        msg = "unexpected %s: %s" % (exc.__class__.__name__, one_line(str(exc), 200))
        warn("error: " + (api.redact(msg) if api is not None else msg))
        return EXIT_ERROR


if __name__ == "__main__":
    sys.exit(main())
