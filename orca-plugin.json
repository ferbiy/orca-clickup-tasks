{
  "manifestVersion": 2,
  "id": "clickup-tasks",
  "name": "ClickUp Tasks",
  "version": "0.1.0",
  "description": "Your ClickUp tasks in Orca's sidebar: start any task in its own worktree with your coding agent, then update its status when the agent is done.",
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "clickup-tasks",
        "title": "ClickUp Tasks",
        "icon": "calendar",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "events": [
      { "on": "agent.status.changed" },
      { "on": "workspace.removed" }
    ]
  },
  "capabilities": [
    { "kind": "secrets:own" },
    { "kind": "storage:own" },
    { "kind": "workspace:read" },
    { "kind": "workspace:create" },
    { "kind": "workspace:write" },
    { "kind": "agent:launch" },
    { "kind": "agent:read" },
    { "kind": "terminal:read" },
    { "kind": "terminal:send" },
    { "kind": "notifications:show" }
  ]
}
